{
	"extends": "expo/tsconfig.base",
	"typeRoots": ["./types", "node"],
	"compilerOptions": {
		"allowJs": true,
		"allowSyntheticDefaultImports": true,
		"esModuleInterop": true,
		"isolatedModules": true,
		"jsx": "react-native",
		"lib": ["esnext"],
		"types": ["react-native", "jest", "node"],
		"moduleResolution": "node",
		"noEmit": true,
		"strict": false,
		"target": "esnext",
		"noImplicitReturns": true,
		"resolveJsonModule": true,
		"skipLibCheck": true,
		"noUncheckedIndexedAccess": true,
		"forceConsistentCasingInFileNames": true,
		"noFallthroughCasesInSwitch": true,
		"noImplicitOverride": true,
		"allowUnreachableCode": false,
		"paths": {
			"@/*": ["./*"]
		}
	},
	"include": [
		"**/*.ts",
		"**/*.tsx",
		"src/**/*",
		"types/**/*",
		".expo/types/**/*.ts",
		"env.d.ts",
		"expo-env.d.ts",
		"components/TabBar.jsx",
		"app/**/*",
		"app/(tabs)/_layout.jsx",
		"app/(tabs)/dico.jsx",
		"app/(tabs)/index.jsx",
		"app/(tabs)/le_jeu.jsx",
		"screen/metiers.jsx",
		"app/playlist.jsx",
		"app/(tabs)/metiers.jsx",
		"screens/CategoriesCards.jsx",
		"components/user"
	],
	"exclude": [
		"node_modules",
		"babel.config.js",
		"metro.config.js",
		"jest.config.js"
	]
}
