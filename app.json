{
	"expo": {
		"name": "Com'Academy",
		"slug": "comacademy",
		"version": "1.2.0",
		"orientation": "portrait",
		"icon": "./assets/imgs/icons/favicon.png",
		"scheme": "comacademy",
		"userInterfaceStyle": "automatic",

		"splash": {
			"image": "./assets/imgs/icons/favicon.png",
			"resizeMode": "contain",
			"backgroundColor": "#f5f5f5"
		},

		"notification": {
			"icon": "./assets/imgs/icons/favicon.png",
			"color": "#ffffff"
		},

		"ios": {
			"supportsTablet": false,
			"bundleIdentifier": "com.nicopipishorts.comacademy",
			"buildNumber": "1.2.0",
			"infoPlist": {
				"ITSAppUsesNonExemptEncryption": false
			}
		},

		"android": {
			"adaptiveIcon": {
				"backgroundColor": "#f5f5f5",
				"foregroundImage": "./assets/imgs/icons/favicon.png"
			},

			"softwareKeyboardLayoutMode": "resize",
			"package": "com.nicopipishorts.comacademy",
			"splash": {
				"image": "./assets/imgs/icons/favicon.png",
				"resizeMode": "contain",
				"backgroundColor": "#f5f5f5"
			}
		},

		"web": {
			"bundler": "metro",
			"output": "static",
			"favicon": "./assets/imgs/icons/favicon.png"
		},

		"plugins": ["expo-router", "expo-font"],
		"experiments": { "typedRoutes": true },
		"extra": {
			"router": { "origin": false },
			"eas": { "projectId": "0fc2cb8b-887f-4ed1-8b55-b94bf6cfec3e" }
		},
		"owner": "nicopipishorts",
		"runtimeVersion": { "policy": "appVersion" },
		"updates": {
			"url": "https://u.expo.dev/0fc2cb8b-887f-4ed1-8b55-b94bf6cfec3e"
		}
	}
}
