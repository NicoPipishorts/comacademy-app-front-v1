{
	"expo": {
		"name": "Com'Academy",
		"slug": "comacademy",
		"version": "0.3.0",
		"orientation": "portrait",
		"icon": "./assets/imgs/icons/favicon.png",
		"scheme": "myapp",
		"userInterfaceStyle": "automatic",
		"splash": {
			"resizeMode": "contain",
			"backgroundColor": "#f5f5f5"
		},
		"ios": {
			"supportsTablet": true,
			"bundleIdentifier": "com.nicopipishorts.comacademy"
		},
		"android": {
			"adaptiveIcon": {
				"backgroundColor": "#f5f5f5",
				"foregroundImage": "./assets/imgs/icons/favicon.png"
			},
			"config": {
				"usesCleartextTraffic": true
			},
			"package": "com.nicopipishorts.comacademy"
		},
		"web": {
			"bundler": "metro",
			"output": "static",
			"favicon": "./assets/imgs/icons/favicon.png"
		},
		"plugins": ["expo-router", "expo-font"],
		"experiments": {
			"typedRoutes": true
		},
		"extra": {
			"router": {
				"origin": false
			},
			"eas": {
				"projectId": "0fc2cb8b-887f-4ed1-8b55-b94bf6cfec3e"
			}
		},
		"owner": "nicopipishorts"
	}
}
